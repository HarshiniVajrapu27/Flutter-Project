# Gitignore for Flutter / Dart projects
# See https://dart.dev/guides/libraries/private-files

# ── Dart / Pub ──────────────────────────────────────────────────────────────
.dart_tool/
.pub-cache/
.pub/
pubspec.lock          # Uncomment if this is a library package
build/

# ── Flutter ──────────────────────────────────────────────────────────────────
.flutter-plugins
.flutter-plugins-dependencies
.packages
.metadata             # keep — used by flutter tool (optional to ignore)

# ── IDE — Visual Studio Code ─────────────────────────────────────────────────
.vscode/
*.code-workspace

# ── IDE — Android Studio / IntelliJ ─────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.gradle/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
*.swp

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── Android ──────────────────────────────────────────────────────────────────
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/android/**/*.keystore
**/android/**/*.jks

# ── iOS ───────────────────────────────────────────────────────────────────────
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/Flutter/.last_build_id
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*

# ── macOS desktop ─────────────────────────────────────────────────────────────
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# ── Linux desktop ─────────────────────────────────────────────────────────────
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/ephemeral/

# ── Windows desktop ───────────────────────────────────────────────────────────
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/ephemeral/

# ── Web ───────────────────────────────────────────────────────────────────────
# Build output — do not commit; generate with `flutter build web`
build/web/

# ── Secrets / environment ─────────────────────────────────────────────────────
*.env
.env.*
secrets.dart
api_keys.dart
google-services.json
GoogleService-Info.plist

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
lcov.info

# ── Generated files ───────────────────────────────────────────────────────────
*.g.dart
*.freezed.dart
*.mocks.dart
